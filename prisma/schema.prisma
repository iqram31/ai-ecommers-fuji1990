generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Supabase Supavisor, port 6543) used at runtime.
  url       = env("DATABASE_URL")
  // Direct/session connection (port 5432) used by Prisma Migrate.
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  description    String
  /// Harga dalam Rupiah (tanpa desimal).
  price          Int
  /// Harga coret sebelum diskon (opsional).
  compareAtPrice Int?
  sizes          String[]
  colors         String[]
  material       String?
  inStock        Boolean        @default(true)
  isFeatured     Boolean        @default(false)
  isPublished    Boolean        @default(true)
  videoUrl       String?
  marketplaceUrl String?
  categoryId     String
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([categoryId])
  @@index([isPublished, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  content      String
  isPublished  Boolean  @default(true)
  showInFooter Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Baris tunggal (id = 1) berisi pengaturan toko.
model SiteSetting {
  id             Int      @id @default(1)
  storeName      String
  tagline        String
  description    String
  whatsappNumber String
  email          String?
  address        String?
  openHours      String?
  instagramUrl   String?
  tiktokUrl      String?
  shopeeUrl      String?
  announcement   String?
  aboutTitle     String
  aboutBody      String
  updatedAt      DateTime @updatedAt
}
